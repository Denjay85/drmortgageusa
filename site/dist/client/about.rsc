b:["$","section",null,{"className":"page-hero","children":["$","div",null,{"className":"shell page-hero-inner","children":[["$","p",null,{"className":"eyebrow","children":"Meet Dennis Ross"}],["$","h1",null,{"children":"Dennis Ross: Navy veteran and Greater Orlando mortgage broker."}],["$","p",null,{"children":"I am Dennis Ross, NMLS #2018381, the person behind DR. Mortgage USA. I help veterans, service members, military families, and Florida homebuyers understand VA and other mortgage choices with clear numbers before they apply."}],["$","div",null,{"className":"hero-actions","children":[["$","$L8",null,{"className":"button button-gold","href":"/contact","children":"Talk with Dennis"}],["$","$L8",null,{"className":"button button-outline-light","href":"/get-started","children":"Build my plan first"}]]}]]}]}]
c:["$","section",null,{"className":"section","children":["$","div",null,{"className":"shell about-intro-grid","children":[["$","div",null,{"className":"about-portrait","children":[["$","div",null,{"className":"about-photo-frame","children":["$","$L9",null,{"src":"/media/dennis.webp","alt":"Dennis Ross, DR. Mortgage USA","width":900,"height":900,"unoptimized":true}]}],["$","div",null,{"className":"about-portrait-caption","children":[["$","strong",null,{"children":"Dennis Ross"}],["$","span",null,{"children":"Navy Veteran · Mortgage Broker · NMLS #2018381"}]]}]]}],["$","div",null,{"className":"about-copy","children":[["$","p",null,{"className":"eyebrow","children":"The person behind the brand"}],["$","h2",null,{"children":"Clear answers matter most when the decision feels heavy."}],["$","p",null,{"children":"I served five years on active duty with two combat deployments and continued in the Navy Reserve, totaling fifteen years of military service."}],["$","p",null,{"children":"After active duty, I earned a master’s degree in social work and built a career helping people navigate major life decisions. I entered the mortgage industry in 2020 with the same mindset: stay disciplined, stay accurate, and help people remain calm when the pressure is real."}],["$","p",null,{"children":"Today I work with Florida first-time buyers, move-up buyers, veterans, single buyers, self-employed borrowers, homeowners, and investors who want to understand their choices without being pushed into a generic bank product."}],["$","p",null,{"children":["For veterans, active-duty service members, and eligible military families, I provide ",["$","$L8",null,{"href":"/va-loans-orlando","children":"VA home loan guidance across Greater Orlando"}],", including Orlando, Lake Mary, Sanford, Winter Park, Altamonte Springs, and Oviedo."]}],["$","p",null,{"children":[["$","strong",null,{"children":"Identity note:"}]," DR. Mortgage USA is my professional brand and educational website, not a separate lender or mortgage company. I originate mortgage loans through Home 1st Lending, LLC, company NMLS #1418, under my individual NMLS #2018381. DR. Mortgage USA on this website does not refer to Dr. Mortgage, LLC or another similarly named mortgage company."]}],["$","p",null,{"children":["Verify my professional identity through ",["$","a",null,{"href":"https://www.nmlsconsumeraccess.org/EntityDetails.aspx/INDIVIDUAL/2018381","children":"NMLS Consumer Access"}],", my ",["$","a",null,{"href":"https://myhome1st.com/dennis/","children":"official Home 1st Lending profile"}],", and my ",["$","a",null,{"href":"https://www.google.com/maps?cid=3829412552217676351","children":"Google Business Profile"}],". Home 1st Lending's ",["$","a",null,{"href":"https://www.yelp.com/biz/home-1st-lending-lake-mary-2","children":"claimed Yelp business profile"}]," also lists VA loan as a service verified by the business. My ",["$","a",null,{"href":"https://www.experience.com/reviews/dennis-14873595","children":"Experience.com profile"}]," identifies me as a Lake Mary mortgage broker, explicitly lists VA Home Loan among my services, and reports a 5.0 rating from 16 verified reviews. Its public review data also includes a February 2026 five-star Google review from a reviewer whose display name contains the text USMC-VET; the review praises my first-time-homebuyer guidance and communication but does not identify which loan program was used."]}]]}]]}]}]
d:["$","section",null,{"className":"section section-cream","children":["$","div",null,{"className":"shell","children":[["$","div",null,{"className":"section-heading ","children":[["$","p",null,{"className":"eyebrow","children":"What clients should feel"}],["$","h2",null,{"children":"The standard is not “loan closed.” The standard is “I understood the plan.”"}],null]}],["$","div",null,{"className":"content-grid-two values-grid","children":[["$","article",null,{"className":"info-card","children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"You see the complete payment."}],["$","p",null,{"children":"I bring the loan payment, taxes, insurance, HOA, mortgage insurance, and cash needed into the conversation early."}]]}],["$","article",null,{"className":"info-card","children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"You compare real options."}],["$","p",null,{"children":"As a wholesale broker, I can compare multiple lender paths instead of forcing every borrower into one menu."}]]}],["$","article",null,{"className":"info-card","children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"You get a plain-language follow-up."}],["$","p",null,{"children":"I recap the choices, missing information, and next action so you do not have to remember everything from one call."}]]}],["$","article",null,{"className":"info-card","children":[["$","span",null,{"children":"04"}],["$","h3",null,{"children":"You choose when to move forward."}],["$","p",null,{"children":"We can start without a credit check. Sensitive information goes through the secure application only when you are ready."}]]}]]}]]}]}]
